# Copy to .env.local for local overrides. Vite only exposes VITE_* to the app.

# Where the API lives. Leave empty (or unset) to keep requests same-origin —
# the dev proxy in vite.config.js and a Vercel rewrite both depend on that.
# Set it only when the deployed frontend must call a backend on another host:
#   VITE_API_URL=https://price-intelligence-api.onrender.com
VITE_API_URL=
